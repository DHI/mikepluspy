{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just *)",
      "PowerShell(just *)"
    ],
    "deny": [
      "Edit(/mikeplus/tables/auto_generated/**)",
      "Edit(/tests/testdata/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qE '\"file_path\": *\"[^\"]*\\.py\"' || exit 0; cd \"$CLAUDE_PROJECT_DIR\" && just fix >&2 || exit 2"
          }
        ]
      }
    ]
  }
}
